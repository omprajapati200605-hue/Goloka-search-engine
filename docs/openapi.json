{
  "components": {
    "schemas": {
      "CrawlRequest": {
        "additionalProperties": false,
        "properties": {
          "allowed_domains": {
            "description": "Extra domains the crawl may visit (the seed's domain is always allowed)",
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Allowed Domains",
            "type": "array"
          },
          "auto_index": {
            "default": true,
            "description": "Index the crawled pages automatically when the crawl finishes",
            "title": "Auto Index",
            "type": "boolean"
          },
          "max_depth": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Link depth limit; defaults to the server setting",
            "title": "Max Depth"
          },
          "max_pages": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Page limit; defaults to the server setting",
            "title": "Max Pages"
          },
          "url": {
            "description": "Seed URL (http/https, public hosts only)",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
