      }
    }
  },
  "info": {
    "description": "GOLOKA search engine API: stored web documents searched by BM25 keywords, semantic embeddings, or both.\n\nOnly documents that were actually crawled and indexed are ever returned.",
    "title": "GOLOKA",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/crawl": {
      "post": {
        "description": "Validates the URL (public http/https hosts only; robots.txt is obeyed during the crawl) and queues a job. Returns immediately with a job id; poll `GET /api/v1/jobs/{id}` for status, progress and errors. Jobs run one at a time, in order.",
        "operationId": "start_crawl_api_v1_crawl_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrawlRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "URL or limits rejected"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many unfinished jobs"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Start a background crawl job",
        "tags": [
          "crawl"
        ]
      }
    },
    "/api/v1/documents": {
      "get": {
        "operationId": "list_documents_api_v1_documents_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "description": "Only documents from this domain",
            "in": "query",
            "name": "domain",
            "required": false,
