# Copy to .env and adjust. All values are optional; defaults shown.
GOLOKA_DATA_DIR=./data
GOLOKA_DB_PATH=./data/goloka.db
GOLOKA_VECTOR_DIR=./data/vectors

# Crawler
GOLOKA_USER_AGENT=GOLOKABot/0.1 (+https://example.com/bot)
GOLOKA_CRAWL_TIMEOUT_SECONDS=10
GOLOKA_CRAWL_MAX_REDIRECTS=5
GOLOKA_CRAWL_MAX_PAGE_BYTES=2000000
GOLOKA_CRAWL_PER_DOMAIN_DELAY_SECONDS=1.0
GOLOKA_CRAWL_CONCURRENCY=4
GOLOKA_CRAWL_DEFAULT_MAX_PAGES=50
GOLOKA_CRAWL_DEFAULT_MAX_DEPTH=2
GOLOKA_CRAWL_HARD_MAX_PAGES=1000
GOLOKA_CRAWL_HARD_MAX_DEPTH=6

# Background jobs
GOLOKA_JOBS_MAX_PENDING=20

# Semantic search
GOLOKA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GOLOKA_CHUNK_SIZE_WORDS=200
GOLOKA_CHUNK_OVERLAP_WORDS=40

# Hybrid search
GOLOKA_HYBRID_BM25_WEIGHT=0.4
GOLOKA_HYBRID_SEMANTIC_WEIGHT=0.4
GOLOKA_HYBRID_TITLE_WEIGHT=0.2
GOLOKA_RRF_K=60
# Cosine similarity below this is not treated as a semantic match. Model-dependent: tune on your own data.
GOLOKA_HYBRID_MIN_SEMANTIC_SCORE=0.2

# API
GOLOKA_API_HOST=127.0.0.1
GOLOKA_API_PORT=8000
GOLOKA_LOG_LEVEL=INFO
# Optional: require the header  X-API-Key: <this value>  on every endpoint except /health
# GOLOKA_API_KEY=change-me
# Optional: browser origins allowed to call the API (JSON list)
# GOLOKA_CORS_ORIGINS=["http://localhost:3000"]
